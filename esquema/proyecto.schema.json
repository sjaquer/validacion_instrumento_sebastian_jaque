{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjaquer.github.io/validacion_instrumento_sebastian_jaque/esquema/proyecto.schema.json",
  "title": "Proyecto de validación por juicio de expertos",
  "description": "Contenido de proyectos/<id>/proyecto.json. Los textos admiten **negrita**, *cursiva* y [enlaces](https://…).",
  "type": "object",
  "required": ["id", "investigacion", "variables"],
  "properties": {
    "$schema": { "type": "string" },
    "version_esquema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Igual al nombre de la carpeta; se usa en ?p=<id>." },
    "estado": { "enum": ["abierto", "cerrado"], "default": "abierto", "description": "Cerrado: muestra un aviso y bloquea las respuestas." },
    "fecha_limite": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Fecha sugerida de entrega (AAAA-MM-DD)." },
    "actualizado": { "type": "string", "description": "Fecha de la última actualización del expediente (AAAA-MM-DD)." },
    "institucion": {
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "siglas": { "type": "string" },
        "unidad": { "type": "string" },
        "programa": { "type": "string" },
        "ciudad": { "type": "string", "default": "Lima" },
        "logo": { "type": "string", "description": "Ruta relativa a la carpeta del proyecto (JPG o PNG)." }
      }
    },
    "tema": {
      "type": "object",
      "properties": { "acento": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Color institucional; el resto de la paleta se deriva de él." } }
    },
    "investigacion": {
      "type": "object",
      "required": ["titulo"],
      "properties": {
        "tipo": { "type": "string" },
        "titulo": { "type": "string" },
        "autor": { "type": "string" },
        "asesor": { "type": "string" },
        "linea": { "type": "string" },
        "enfoque": { "type": "string" },
        "instrumento": { "type": "string" }
      }
    },
    "contacto": {
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "whatsapp": { "type": "string", "pattern": "^\\d{8,15}$", "description": "Con código de país y sin «+» (p. ej., 51999999999)." },
        "correo": { "type": "string", "format": "email" }
      }
    },
    "carta": {
      "type": "object",
      "properties": {
        "asunto": { "type": "string" },
        "parrafos": { "type": "array", "items": { "type": "string" }, "description": "{area} se reemplaza con el área del experto." },
        "contenido_titulo": { "type": "string" },
        "contenido": { "type": "array", "items": { "type": "string" } },
        "cierre": { "type": "string" },
        "firma": { "type": "string" }
      }
    },
    "documentos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["titulo"],
        "properties": {
          "titulo": { "type": "string" },
          "descripcion": { "type": "string" },
          "archivo": { "type": "string", "description": "Ruta del PDF personalizado; {clave} se reemplaza con la clave del experto." },
          "archivo_general": { "type": "string", "description": "PDF para quien abre la página sin enlace personal." }
        }
      }
    },
    "evaluacion": {
      "type": "object",
      "properties": {
        "minutos": { "type": "integer", "minimum": 1 },
        "criterios": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["clave", "nombre", "definicion"], "properties": { "clave": { "type": "string" }, "nombre": { "type": "string" }, "definicion": { "type": "string" } } }
        },
        "escala": {
          "type": "array", "minItems": 2,
          "description": "Opciones de cada criterio. El valor mayor se muestra en verde y el menor en rojo (p. ej., Sí = 1 / No = 0, o 1 a 4).",
          "items": { "type": "object", "required": ["valor", "etiqueta"], "properties": { "valor": { "type": "number" }, "etiqueta": { "type": "string" } } }
        },
        "suficiencia": { "type": "object", "properties": { "activa": { "type": "boolean" }, "definicion": { "type": "string" } } },
        "aplicabilidad": { "type": "array", "items": { "type": "string" } },
        "grados": { "type": "array", "items": { "type": "object", "properties": { "valor": { "type": "string" }, "etiqueta": { "type": "string" } } } },
        "documento_identidad": { "type": "object", "properties": { "nombre": { "type": "string" }, "patron": { "type": "string" } } }
      }
    },
    "variables": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["numero", "nombre", "dimensiones"],
        "properties": {
          "numero": { "type": "integer" },
          "nombre": { "type": "string" },
          "definicion": { "type": "string" },
          "escala": { "type": "string" },
          "niveles": { "type": "array", "items": { "type": "string" } },
          "dimensiones": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["numero", "nombre", "items"],
              "properties": {
                "numero": { "type": "integer" },
                "nombre": { "type": "string" },
                "definicion": { "type": "string" },
                "indicadores": { "type": "array", "items": { "type": "object", "properties": { "nombre": { "type": "string" }, "items": { "type": "array", "items": { "type": "integer" } } } } },
                "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["numero", "texto"], "properties": { "numero": { "type": "integer" }, "texto": { "type": "string" } } } }
              }
            }
          }
        }
      }
    },
    "nota_matriz": { "type": "string" },
    "cuestionario": {
      "type": "object",
      "description": "Vista previa del cuestionario tal como lo verán los participantes (opcional).",
      "properties": {
        "titulo": { "type": "string" },
        "presentacion": { "type": "string" },
        "notas": { "type": "array", "items": { "type": "string" } },
        "bloques": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["titulo", "tipo"],
            "properties": {
              "titulo": { "type": "string" },
              "tipo": { "enum": ["opciones", "escala"] },
              "preguntas": { "type": "array", "items": { "type": "object", "properties": { "texto": { "type": "string" }, "nota": { "type": "string" }, "opciones": { "type": "array", "items": { "type": "string" } } } } },
              "instrucciones": { "type": "string" },
              "escala": { "type": "array", "items": { "type": "string" } },
              "grupos": { "type": "array", "items": { "type": "object", "properties": { "titulo": { "type": "string" }, "items": { "type": "array" } } } }
            }
          }
        },
        "cierre": { "type": "string" }
      }
    },
    "certificado": {
      "type": "object",
      "properties": {
        "titulo": { "type": "string" },
        "nota": { "type": "string" },
        "etiqueta_observaciones": { "type": "string" },
        "etiqueta_juez": { "type": "string" },
        "etiqueta_firma": { "type": "string" }
      }
    },
    "expertos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clave", "grado", "nombre"],
        "properties": {
          "clave": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Va en el enlace: ?e=<clave>." },
          "grado": { "type": "string" },
          "nombre": { "type": "string" },
          "tratamiento": { "type": "string" },
          "rol": { "type": "string" },
          "area": { "type": "string", "description": "Completa «experiencia en temas de {area}» de la carta." },
          "especialidad": { "type": "string" }
        }
      }
    }
  }
}
